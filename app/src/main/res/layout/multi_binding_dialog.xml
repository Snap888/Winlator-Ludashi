<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="400dp"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Multi-Action Binding"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Binding Type Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="#f8f9fa"
            android:padding="8dp">

            <CheckBox
                android:id="@+id/checkbox_simultaneous"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simultaneous (A+B)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:checked="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sequential: A→B→C"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginStart="28dp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Actions Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Actions:"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_add_binding"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="Add"
                android:backgroundTint="#4CAF50"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- Bindings Container -->
        <LinearLayout
            android:id="@+id/bindings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="#f5f5f5"
            android:padding="6dp" />

        <!-- Preview Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:background="#e3f2fd"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/text_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NONE"
                android:textSize="14sp"
                android:textStyle="italic"
                android:gravity="center"
                android:padding="6dp"
                android:background="@android:color/white" />

        </LinearLayout>

        <!-- Examples Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp"
            android:background="#fff3e0"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Examples:"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• A+B (gamepad)"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• L CTRL+C (copy)"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• ALT+TAB (switch)"
                android:textSize="10sp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• A→B→C (sequence)"
                android:textSize="10sp"
                android:textColor="#666666" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>